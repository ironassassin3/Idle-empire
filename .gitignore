__pycache__/
*.pyc
*.pyo
graphify-out/

# /godot-design render output (design scenes themselves ARE committed).
/godot/design/shots/
/backups/

# Native Android plugin binaries — install per godot/addons/PLUGINS.md, never commit.
/godot/_plugin_staging/
/godot/addons/GodotGooglePlayBilling/
/godot/addons/GodotPlayGameServices/
/godot/addons/admob/

# Native iOS plugin binaries (AdMob xcframeworks / .a libs) — install locally, never commit.
/godot/ios/

# Built Windows binary (~105 MB) — rebuild via IdleEmpire.spec, ship as a release
# artifact. Note: the copies already in history are NOT removed by this rule.
/dist/IdleEmpire.exe

# Per-machine Claude Code settings (tool permissions etc.). The shared team config
# is .claude/settings.json, which stays tracked.
/.claude/settings.local.json
